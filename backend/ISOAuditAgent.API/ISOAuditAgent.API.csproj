<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Sdk.Web agrupa todos los *.cs bajo esta carpeta; los proyectos referenciados están anidados y deben compilarse sólo como referencias de proyecto. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Contracts\**;Corpus\**;Agents\**;Infrastructure\**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>828fa331-7fdc-44b9-87c7-14725381f4bb</UserSecretsId>
    <!-- Sdk.Web agrupa todos los *.cs bajo esta carpeta; los proyectos referenciados están anidados y deben compilarse sólo como referencias de proyecto. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Contracts\**;Corpus\**;Agents\**;Infrastructure\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Apis.Drive.v3" Version="1.74.0.4135" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.14" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Agents\DocumentAnalysis\ISOAuditAgent.DocumentAnalysis.csproj" />
    <ProjectReference Include="Corpus\ISOAuditAgent.Corpus.csproj" />
    <ProjectReference Include="Contracts\ISOAuditAgent.Contracts.csproj" />
    <ProjectReference Include="Infrastructure\ISOAuditAgent.Infrastructure.csproj" />
  </ItemGroup>

  <!--
    Copia el PDF de la norma ISO 9001 al directorio de salida para que el host
    disponga de una ruta estable durante la ejecución (data/norma/...).
    Los artefactos generados por la indexación (chunks/embeddings) NO deben
    versionarse; viven bajo data/index/ y están excluidos por .gitignore.
  -->
  <ItemGroup>
    <Content Include="data\norma\NOM_ISO_9001-2015.pdf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
